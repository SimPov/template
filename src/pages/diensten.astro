---
/**
 * Detailpagina van `content.features.items`. Route blijft `/diensten`, maar de
 * pagina toont whatever in `content.features` staat — diensten, functies,
 * producten of een menu.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';
import siteConfig from '../config/site.config';

const { content } = siteConfig;
const features = content.features;
const items = features?.items ?? [];
const meta = content.pages.diensten;
const ctaButton = content.ctaButton;
---

<BaseLayout
  title={meta?.title ?? 'Diensten'}
  description={meta?.description}
  breadcrumbs={meta ? [{ name: meta.title, href: '/diensten' }] : undefined}
>
  <section class="border-b border-black/10 bg-white/50 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{meta?.title ?? 'Diensten'}</h1>
      {meta?.intro && <p class="mt-6 text-lg text-brand-text/80">{meta.intro}</p>}
    </div>
  </section>

  {
    items.length > 0 && (
      <section class="py-16 sm:py-20">
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <ul class="grid gap-6 md:grid-cols-2">
            {items.map((item) => (
              <li
                id={item.id}
                class="flex scroll-mt-24 flex-col rounded-lg border border-black/10 bg-white/60 p-6 sm:p-8"
              >
                <h2 class="text-2xl font-bold text-primary">{item.title}</h2>
                <p class="mt-3 text-brand-text/85">{item.shortDesc}</p>

                {item.details && item.details.length > 0 && (
                  <>
                    <h3 class="mt-6 text-sm font-semibold uppercase tracking-wide text-brand-text/70">
                      Wat krijg je?
                    </h3>
                    <ul class="mt-3 space-y-2 text-sm text-brand-text/85">
                      {item.details.map((detail) => (
                        <li class="flex gap-2">
                          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
                          <span>{detail}</span>
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                {item.meta && (
                  <p class="mt-6 border-t border-black/10 pt-4 text-lg font-semibold text-primary">
                    {item.meta}
                  </p>
                )}

                {ctaButton && (
                  <a
                    href={ctaButton.href}
                    class="mt-6 inline-block rounded-md bg-primary px-5 py-3 text-center font-semibold text-white transition-colors hover:bg-primary-hover"
                    aria-label={`Neem contact op voor ${item.title}`}
                  >
                    {ctaButton.label} — {item.title}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <ProcessSection />
  <FaqSection />
  <CtaBanner />
</BaseLayout>
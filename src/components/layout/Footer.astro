---
import siteConfig from '../../config/site.config';

const { site, legal, contact, location, socials, content } = siteConfig;
const year = new Date().getFullYear();
const socialEntries = Object.entries(socials).filter((entry): entry is [string, string] => Boolean(entry[1]));
const socialLabels: Record<string, string> = {
  linkedin: 'LinkedIn',
  googleMaps: 'Google Maps',
  kvkRegistry: 'KvK-register',
  instagram: 'Instagram',
};
---

<footer class="border-t border-black/10 bg-white/60">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="text-lg font-bold text-primary">{site.name}</p>
      <p class="mt-2 max-w-sm text-sm text-brand-text/80">{site.slogan}</p>
      <p class="mt-4 text-xs text-brand-text/70">
        {site.legalName} · KvK {legal.kvk} · Btw {legal.btw}
      </p>
    </div>

    <nav aria-label="Voettekst navigatie">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-text/70">Navigatie</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          content.navigation.map((item) => (
            <li>
              <a href={item.href} class="hover:text-primary">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-text/70">Contact</h2>
      <address class="mt-3 space-y-2 text-sm not-italic">
        <a href={`tel:${contact.phone}`} class="block hover:text-primary">{contact.phone}</a>
        <a href={`mailto:${contact.email}`} class="block break-all hover:text-primary">{contact.email}</a>
        <p>
          {location.streetAddress}<br />
          {location.postalCode} {location.addressLocality}
        </p>
      </address>
      <ul class="mt-4 space-y-1 text-sm">
        {
          socialEntries.map(([key, url]) => (
            <li>
              <a href={url} rel="me noopener" target="_blank" class="hover:text-primary">
                {socialLabels[key] ?? key}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-black/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-xs text-brand-text/70 sm:flex-row sm:justify-between sm:px-6">
      <p>© {year} {site.legalName}. Alle rechten voorbehouden.</p>
      <ul class="flex gap-4">
        <li><a href={legal.privacyPolicyUrl} class="hover:text-primary">Privacyverklaring</a></li>
        <li><a href={legal.termsUrl} class="hover:text-primary">Algemene voorwaarden</a></li>
        <li><a href="/llms.txt" class="hover:text-primary">llms.txt</a></li>
      </ul>
    </div>
  </div>
</footer>
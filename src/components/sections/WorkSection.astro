---
/**
 * Generieke "work"-sectie: cases, projecten, portfolio of referenties.
 * Rendert niets wanneer `content.work` ontbreekt of leeg is.
 */
import siteConfig from '../../config/site.config';

const work = siteConfig.content.work;
const items = work?.items ?? [];
---

{
  work && items.length > 0 && (
    <section id="cases" class="scroll-mt-24 border-y border-black/10 bg-white/50 py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 data-reveal class="text-3xl font-bold tracking-tight sm:text-4xl">
          {work.heading}
        </h2>
        {work.intro && (
          <p data-reveal class="mt-3 max-w-2xl text-brand-text/80" style="--reveal-delay: 100ms">
            {work.intro}
          </p>
        )}

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {items.map((item, index) => (
            <article
              id={item.id}
              data-reveal
              class="flex scroll-mt-24 flex-col rounded-lg border border-black/10 bg-neutral-bg p-6"
              style={`--reveal-delay: ${index * 100}ms`}
            >
              {item.client && (
                <p class="text-sm font-medium uppercase tracking-wide text-brand-text/60">
                  {item.client}
                </p>
              )}
              <h3 class={`text-lg font-semibold text-primary ${item.client ? 'mt-2' : ''}`}>
                {item.title}
              </h3>

              {item.summary && <p class="mt-3 text-sm text-brand-text/80">{item.summary}</p>}

              {item.body && item.body.length > 0 && (
                <div class="mt-3 space-y-2 text-sm text-brand-text/80">
                  {item.body.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              )}

              {item.tags && item.tags.length > 0 && (
                <ul class="mt-5 flex flex-wrap gap-2 border-t border-black/10 pt-4">
                  {item.tags.map((tag) => (
                    <li class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                      {tag}
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
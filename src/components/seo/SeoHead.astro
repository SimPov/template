---
import siteConfig from '../../config/site.config';
import Schema, { type Crumb } from './Schema.astro';

interface Props {
  /** Titel van de pagina, zonder de site-suffix. */
  title: string;
  description?: string;
  /** Pad van de OG-afbeelding in /public. Valt terug op `site.ogImage`. */
  image?: string;
  breadcrumbs?: Crumb[];
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.site.description,
  image,
  breadcrumbs,
  noindex = false,
} = Astro.props as Props;

const { site } = siteConfig;

// 'nl-NL' -> 'nl_NL' voor OpenGraph.
const ogLocale = (site.locale ?? 'nl-NL').replace('-', '_');

// Google SEO Starter Guide template: [Pagina Titel] | Name – Slogan
const fullTitle = title === site.name
  ? `${site.name} – ${site.slogan}`
  : `${title} | ${site.name} – ${site.slogan}`;

// `Astro.site` is deprecated (and `Astro.generator` throws in Astro 8).
// `import.meta.env.SITE` comes from `site` in astro.config.mjs and works
// in every context, including during static path generation.
const siteBase = import.meta.env.SITE || siteConfig.site.url;

// Canonical: de site-basis + het huidige pathname
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', siteBase).href;
const ogImage = image ? new URL(image, siteBase).href : undefined;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
<meta name="author" content={site.legalName ?? site.name} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{
  ogImage && (
    <>
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:alt" content={`${site.name} – ${site.slogan}`} />
    </>
  )
}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{
  ogImage && <meta name="twitter:image" content={ogImage} />
}

<link rel="sitemap" href="/sitemap-index.xml" />

<Schema breadcrumbs={breadcrumbs} title={title} />
---
import siteConfig from '../../config/site.config';

const { cases } = siteConfig.content;
---

<section id="cases" class="scroll-mt-24 border-y border-black/10 bg-white/50 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Resultaten</h2>
    <p class="mt-3 max-w-2xl text-brand-text/80">
      Een selectie van ondernemers die met een nieuwe website meer werden gehaald.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        cases.map((item) => (
          <article class="flex flex-col rounded-lg border border-black/10 bg-neutral-bg p-6">
            <p class="text-sm font-medium uppercase tracking-wide text-brand-text/60">{item.client}</p>
            <h3 class="mt-2 text-lg font-semibold text-primary">{item.title}</h3>
            <p class="mt-3 text-sm text-brand-text/80">
              <strong class="font-semibold">Uitdaging:</strong> {item.challenge}
            </p>
            <p class="mt-2 text-sm text-brand-text/80">
              <strong class="font-semibold">Aanpak:</strong> {item.result}
            </p>
            <ul class="mt-5 flex flex-wrap gap-2 border-t border-black/10 pt-4">
              {item.metrics.map((metric) => (
                <li class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                  {metric}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
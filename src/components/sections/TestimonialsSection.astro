---
import siteConfig from '../../config/site.config';

const testimonials = siteConfig.content.testimonials;
const items = testimonials?.items ?? [];
---

{
  testimonials && items.length > 0 && (
    <section id="ervaringen" class="scroll-mt-24 py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 data-reveal class="text-3xl font-bold tracking-tight sm:text-4xl">
          {testimonials.heading}
        </h2>

        <ul class="mt-12 grid gap-6 md:grid-cols-3">
          {items.map((item, index) => (
            <li
              data-reveal
              class="flex flex-col rounded-lg border border-black/10 bg-white/60 p-6"
              style={`--reveal-delay: ${index * 100}ms`}
            >
              <blockquote class="flex-1 text-brand-text/90">
                <p aria-hidden="true" class="text-3xl leading-none text-primary">“</p>
                <p class="mt-1">{item.quote}</p>
              </blockquote>
              <footer class="mt-5 border-t border-black/10 pt-4 text-sm">
                <cite class="not-italic font-semibold">{item.author}</cite>
                {item.company && <span class="block text-brand-text/70">{item.company}</span>}
              </footer>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
---
import siteConfig from '../../config/site.config';

const { content } = siteConfig;
const { services, ctaButton } = content;
---

<section id="diensten" class="scroll-mt-24 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Onze diensten</h2>
    <p class="mt-3 max-w-2xl text-brand-text/80">
      Van een fris ontwerp tot een website die online verkoopt. Bekijk wat wij voor je kunnen betekenen.
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service) => (
          <article
            id={service.id}
            class="flex scroll-mt-24 flex-col rounded-lg border border-black/10 bg-white/60 p-6 transition-shadow hover:shadow-md"
          >
            <h3 class="text-lg font-semibold text-primary">{service.title}</h3>
            <p class="mt-3 flex-1 text-sm text-brand-text/80">{service.shortDesc}</p>
            <p class="mt-5 border-t border-black/10 pt-4 text-sm font-semibold">{service.priceTier}</p>
            <a
              href={`/diensten#${service.id}`}
              class="mt-4 inline-block text-sm font-medium text-primary underline underline-offset-4 hover:text-primary-hover"
              aria-label={`Lees meer over ${service.title}`}
            >
              Meer over {service.title}
            </a>
          </article>
        ))
      }
    </div>

    <p class="mt-10">
      <a
        href={ctaButton.href}
        class="rounded-md bg-primary px-6 py-3 font-semibold text-white transition-colors hover:bg-primary-hover"
      >
        {ctaButton.label}
      </a>
    </p>
  </div>
</section>